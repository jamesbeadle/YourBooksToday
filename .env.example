# Supabase project URL and publishable key — used by the browser and server clients.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key — used by the MCP server to resolve a caller and read the site model.
SUPABASE_SECRET_KEY=

# Resend API key and sender address for transactional email.
RESEND_API_KEY=
EMAIL_FROM="Your Books Today <hello@yourbooks.today>"

# Where enquiries from /contact are sent. Leave empty to accept them without emailing.
ENQUIRY_NOTIFICATION_EMAIL=
